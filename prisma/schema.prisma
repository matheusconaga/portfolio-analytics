generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Visitor {
  id        String    @id
  createdAt DateTime  @default(now())

  sessions  Session[]

  @@index([createdAt])
}

model Session {
  id             String   @id
  visitorId      String
  startedAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())
  referrer       String?
  userAgent      String?
  createdAt      DateTime @default(now())

  visitor        Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  events         Event[]

  @@index([visitorId])
  @@index([startedAt])
}

model Event {
  id           String   @id
  sessionId    String
  type         String
  page         String?
  projectSlug  String?
  metadata     Json?
  createdAt    DateTime @default(now())

  session      Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([type])
  @@index([createdAt])
}